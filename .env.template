# Korgut Commons — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# Django core -- leave unset for local dev (defaults: insecure dev key, DEBUG=true,
# ALLOWED_HOSTS=*). Set all three on any server reachable outside localhost (e.g. EC2).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: PostgreSQL for persistent knowledge base
# If not set, knowledge base runs in memory only
# DATABASE_URL=postgresql://user:password@localhost:5432/korgut_commons

GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback/
GITHUB_OAUTH_TOKEN_KEY=generate_with_fernet_as_shown_above

# Celery / Redis -- background delivery for push notifications
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set to true only in tests/local dev without a running worker -- runs tasks
# inline instead of enqueueing them.
CELERY_TASK_ALWAYS_EAGER=false

# Expo push notifications (student mobile app)
EXPO_PUSH_ACCESS_TOKEN=

EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@korgut.example.com